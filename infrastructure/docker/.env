POSTGRES_USER=space_invaders
POSTGRES_PASSWORD=space_invaders
POSTGRES_DB=space_invaders

APP_NAME=Space Invaders Telemetry API
API_VERSION=0.1.0
DEBUG=false
LOG_LEVEL=INFO
API_PORT=8000

AIRFLOW_UID=1000
FERNET_KEY=o9aItatJbPVepoa0sELw5VTA8Sp-FtxSKubbn4a4ZDk=
AIRFLOW__API_AUTH__JWT_SECRET=airflow_jwt_secret
AIRFLOW__API_AUTH__JWT_ISSUER=airflow
_AIRFLOW_WWW_USER_USERNAME=airflow
_AIRFLOW_WWW_USER_PASSWORD=airflow

# Registers the "telemetry_postgres" Airflow Connection from the environment
# (https://airflow.apache.org/docs/apache-airflow/stable/howto/connection.html#connection-uri-format),
# so DAGs/hooks reference it by conn_id instead of hardcoding credentials.
AIRFLOW_CONN_TELEMETRY_POSTGRES=postgres://space_invaders:space_invaders@postgres:5432/space_invaders
